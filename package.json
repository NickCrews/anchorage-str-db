{
  "name": "anchorage-str-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Daily Anchorage, AK short-term rental database builder with historical listings and availability",
  "license": "MIT",
  "scripts": {
